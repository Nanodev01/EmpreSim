# Base de datos para desarrollo local (en Docker se usa /app/data/simulador.db)
DATABASE_URL="file:./simulador.db"

# Dominio público: Caddy obtiene y renueva el certificado HTTPS para este nombre
DOMAIN=localhost

# Claves de IA opcionales: quedan solo en el servidor. Sin clave, se usa el auditor heurístico.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=
